# Plantilla de variables de entorno. NO contiene secretos y no debe tenerlos.
# Genera un infra/.env con secretos aleatorios con:   make dev-env
# (equivale a ejecutar scripts/gen-env.sh). Las variables vacías son obligatorias:
# docker compose y el backend se niegan a arrancar mientras sigan vacías.

# Entorno de ejecución (development | production)
# ADVERTENCIA: En producción debe establecerse explícitamente a 'production'.
# En producción el backend bloquea el arranque con secretos débiles o de ejemplo.
ENVIRONMENT=development

# Servidor Backend
PORT=8080
HOST=0.0.0.0
SOURCE_REPO_URL=https://github.com/kripiman/Baze
# GIT_COMMIT_HASH: en producción debe ser el hash (hex minúscula) con el que se construyó la imagen.
# `make dev-up` lo toma de `git rev-parse HEAD`; en un despliegue lo inyecta el pipeline de build.

# Base de Datos (PostgreSQL + PostGIS)
POSTGRES_DB=baze_db
POSTGRES_USER=baze_user
POSTGRES_PASSWORD=
# URL completa: postgres://baze_user:<POSTGRES_PASSWORD>@postgis:5432/baze_db
DATABASE_URL=

# Motores Internos (red Docker privada)
VALHALLA_URL=http://valhalla:8002
PHOTON_URL=http://photon:2322

# Seguridad y Autenticación
# Clave de firma de tokens: mínimo 32 bytes aleatorios (openssl rand -hex 32).
JWT_SECRET=
RATE_LIMIT_REQUESTS_PER_MINUTE=60
# Proxies de confianza para X-Real-IP (separados por coma: IP o rangos CIDR)
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

# Dominio y Ruteo
HAZARD_CONFIRMATION_THRESHOLD=3
HAZARD_DEFAULT_TTL_HOURS=24

# Caddy / TLS
DOMAIN=localhost
