# Entorno de ejecución (development | production)
# ADVERTENCIA: En producción debe establecerse explícitamente a 'production'.
# En producción, el backend bloquea el arranque si se usan contraseñas o secretos débiles.
ENVIRONMENT=development

# Servidor Backend
PORT=8080
HOST=0.0.0.0
SOURCE_REPO_URL=https://github.com/kripiman/Baze
GIT_COMMIT_HASH=development

# Base de Datos (PostgreSQL + PostGIS)
POSTGRES_DB=baze_db
POSTGRES_USER=baze_user
POSTGRES_PASSWORD=baze_secure_password_replace_in_production
DATABASE_URL=postgres://baze_user:baze_secure_password_replace_in_production@postgis:5432/baze_db

# Motores Internos (red Docker privada)
VALHALLA_URL=http://valhalla:8002
PHOTON_URL=http://photon:2322

# Seguridad y Autenticación
JWT_SECRET=change_me_to_a_random_32_bytes_secret_key_in_production
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Dominio y Ruteo
HAZARD_CONFIRMATION_THRESHOLD=3
HAZARD_DEFAULT_TTL_HOURS=24

# Caddy / TLS
DOMAIN=localhost
ACME_EMAIL=admin@baze.cl # TODO(verify): Dirección de correo para certificados Let's Encrypt
