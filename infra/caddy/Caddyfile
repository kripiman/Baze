{
    # Plazos del servidor: sin ellos un cliente que no termina de enviar la petición ocupa una
    # conexión indefinidamente. No se fija `write` para no cortar los streams SSE.
    servers {
        timeouts {
            read_header 10s
            read_body 30s
            idle 2m
        }
    }
}

{$DOMAIN:localhost} {
    # Compresión gzip y zstd
    encode gzip zstd

    # Cabeceras de seguridad globales
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), camera=(), microphone=()"
        Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
    }

    # La documentación interactiva de la API nunca es pública; el contrato vive en contracts/openapi.json.
    @docs path /swagger-ui /swagger-ui/* /api-docs /api-docs/*
    respond @docs 404

    # Artefactos públicos estáticos (PMTiles, manifiesto, estilo). Solo se monta data/out/public, sin listado de
    # directorios. El cliente es nativo, así que no hace falta CORS. `file_server` atiende las peticiones Range
    # (anuncia Accept-Ranges: bytes) y valida con ETag/Last-Modified: la app repite la descarga solo si hay un
    # mapa nuevo, y max-age corto evita que un proxy intermedio sirva uno viejo durante horas.
    handle_path /static/* {
        root * /var/www/static
        header Cache-Control "public, max-age=300, must-revalidate"
        file_server
    }

    # Proxy reverso al backend Rust (API, /health, /source, /api/v1/*)
    handle {
        # Ninguna petición legítima supera unos pocos KiB; el backend aplica su propio límite.
        request_body {
            max_size 16KB
        }
        reverse_proxy backend:8080 {
            # El backend solo confía en X-Real-IP si la conexión viene de la IP de este contenedor.
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            # Soporte de streaming para SSE
            flush_interval -1
            transport http {
                dial_timeout 3s
                response_header_timeout 15s
            }
        }
    }

    # Sin registro de accesos a propósito: la línea de petición lleva la caja geográfica del mapa y el
    # texto de búsqueda, y el par remoto lleva la IP. Los errores y el arranque siguen en stderr.
}
