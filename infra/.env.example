# Plantilla de variables de entorno. NO contiene secretos y no debe tenerlos.
# Genera un infra/.env con secretos aleatorios con:   make dev-env
# (equivale a ejecutar scripts/gen-env.sh). Las variables vacías son obligatorias:
# docker compose y el backend se niegan a arrancar mientras sigan vacías.

# Entorno de ejecución (development | production)
# ADVERTENCIA: En producción debe establecerse explícitamente a 'production'.
# En producción el backend bloquea el arranque con secretos débiles o de ejemplo.
ENVIRONMENT=development

# Servidor Backend
PORT=8080
HOST=0.0.0.0
SOURCE_REPO_URL=https://github.com/kripiman/Baze
# GIT_COMMIT_HASH: en producción debe ser el hash (hex minúscula) con el que se construyó la imagen.
# `make dev-up` lo toma de `git rev-parse HEAD`; en un despliegue lo inyecta el pipeline de build.

# Base de Datos (PostgreSQL + PostGIS). Dos roles (docs/adr/0008):
#   POSTGRES_USER  dueño del esquema; solo lo usa el servicio `migrate`.
#   baze_app       rol del backend: lee y escribe filas, sin DDL, sin extensiones, sin programas.
POSTGRES_DB=baze_db
POSTGRES_USER=baze_user
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
# URL del rol de aplicación:  postgres://baze_app:<APP_DB_PASSWORD>@postgis:5432/baze_db
DATABASE_URL=
# URL del rol dueño:          postgres://baze_user:<POSTGRES_PASSWORD>@postgis:5432/baze_db
MIGRATION_DATABASE_URL=

# Motores Internos (red Docker privada)
# Apagados por defecto: ruteo y búsqueda de direcciones responden 501. Pon `true` solo cuando el perfil
# `engines` esté levantado con sus datos construidos (data/README.md); sin motores, cada petición fallaría con 502.
ENGINES_ENABLED=false
VALHALLA_URL=http://valhalla:8002
PHOTON_URL=http://photon:2322
# Usuario con el que corren Valhalla y Photon: el mismo que ejecutó data/scripts/03 y 04, dueño de los datos.
# `make dev-env` pone aquí tu uid y gid; en un servidor, usa los de la cuenta que construye los datos.
ENGINES_UID=1000
ENGINES_GID=1000
# Hilos de Valhalla y memoria de Photon (JVM). Vacío = valor por defecto (2 hilos, -Xmx1g).
VALHALLA_THREADS=
PHOTON_JAVA_OPTS=

# Seguridad y Autenticación
# Clave de firma de tokens: mínimo 32 bytes aleatorios (openssl rand -hex 32).
JWT_SECRET=
# Rotación: al cambiar JWT_SECRET, copia aquí el valor anterior; sus tokens siguen valiendo hasta que
# caduquen (AUTH_TOKEN_TTL_DAYS). Cuando haya pasado ese plazo, déjalo vacío. Vacío = sin rotación.
JWT_SECRET_PREVIOUS=
# Validez de los tokens de cuenta, en días (1-730). Vacío = 180.
AUTH_TOKEN_TTL_DAYS=
RATE_LIMIT_REQUESTS_PER_MINUTE=60
# Vacío = valor por defecto. Plazo máximo de una petición (s, 1-120) y peticiones simultáneas en vuelo.
REQUEST_TIMEOUT_SECONDS=
MAX_CONCURRENT_REQUESTS=
# Anti-abuso (ADR-0007). Vacío = valor por defecto. Edad mínima de una cuenta para votar o reportar un
# bloqueo (s, 0-86400; 600), reportes nuevos por cuenta y día (1-1000; 30), votos por cuenta y día (1-5000; 200).
ACCOUNT_MIN_AGE_SECONDS=
REPORTS_PER_ACCOUNT_PER_DAY=
VOTES_PER_ACCOUNT_PER_DAY=
# Swagger UI y /api-docs: por defecto activos en development y apagados en production (true | false).
ENABLE_API_DOCS=
# Proxies de confianza para X-Real-IP (separados por coma: IP o rangos CIDR)
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

# Dominio y Ruteo
HAZARD_CONFIRMATION_THRESHOLD=3
HAZARD_DEFAULT_TTL_HOURS=24

# Caddy / TLS
DOMAIN=localhost
